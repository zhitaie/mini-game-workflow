{
  "name": "mini-game-workflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "serve:api": "node services/api-server/dist/services/api-server/src/cli.js",
    "dev:stack": "node scripts/start-dev-stack.mjs",
    "db:init": "node --experimental-specifier-resolution=node scripts/init-dev-db.mjs",
    "verify:dev-stack": "node --experimental-specifier-resolution=node scripts/verify-dev-stack.mjs",
    "verify:http": "node --experimental-specifier-resolution=node scripts/verify-http-server.mjs",
    "verify:sample-browser": "node --experimental-specifier-resolution=node scripts/verify-game-sample-browser.mjs",
    "verify:save-migration": "node --experimental-specifier-resolution=node scripts/verify-save-manager-migration.mjs",
    "verify:minimal": "node --experimental-specifier-resolution=node scripts/verify-minimal-flow.mjs",
    "verify:admin": "node --experimental-specifier-resolution=node scripts/verify-admin-flow.mjs",
    "verify:admin-authz": "node --experimental-specifier-resolution=node scripts/verify-admin-authz.mjs",
    "verify:admin-filters": "node --experimental-specifier-resolution=node scripts/verify-admin-filters.mjs",
    "verify:admin-mutations": "node --experimental-specifier-resolution=node scripts/verify-admin-mutations.mjs",
    "verify:admin-shell": "node --experimental-specifier-resolution=node scripts/verify-admin-shell.mjs",
    "verify:admin-render": "node --experimental-specifier-resolution=node scripts/verify-admin-render.mjs",
    "verify:persistence": "node --experimental-specifier-resolution=node scripts/verify-persistence-flow.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
